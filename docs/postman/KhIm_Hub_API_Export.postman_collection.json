{
  "info": {
    "_postman_id": "d9c2433b-7c43-4bc6-a145-khim-hub-api",
    "name": "KhIm Hub API",
    "description": "Collection demo cho đồ án KhIm Hub. Chọn Environment KhIm Hub Local trước khi gửi request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "resourceId", "value": "1" },
    { "key": "pendingResourceId", "value": "1" },
    { "key": "favoriteResourceId", "value": "1" },
    { "key": "userId", "value": "2" },
    { "key": "subjectId", "value": "1" },
    { "key": "categoryId", "value": "1" }
  ],
  "item": [
    {
      "name": "01. Health Check",
      "item": [{
        "name": "API health",
        "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/health" },
        "response": []
      }]
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Login - Lecturer",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Đăng nhập thành công', function () { pm.response.to.have.status(200); });", "pm.environment.set('token', pm.response.json().token);", "pm.environment.set('lecturerToken', pm.response.json().token);"] } }],
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"email\": \"lecturer@demo.local\",\n  \"password\": \"Demo@123\"\n}" }, "url": "{{baseUrl}}/auth/login" },
          "response": []
        },
        {
          "name": "Login - Admin",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Đăng nhập admin thành công', function () { pm.response.to.have.status(200); });", "pm.environment.set('token', pm.response.json().token);", "pm.environment.set('adminToken', pm.response.json().token);"] } }],
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@demo.local\",\n  \"password\": \"Demo@123\"\n}" }, "url": "{{baseUrl}}/auth/login" },
          "response": []
        },
        {
          "name": "Login - Student",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Đăng nhập sinh viên thành công', function () { pm.response.to.have.status(200); });", "pm.environment.set('token', pm.response.json().token);", "pm.environment.set('studentToken', pm.response.json().token);"] } }],
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"email\": \"student@demo.local\",\n  \"password\": \"Demo@123\"\n}" }, "url": "{{baseUrl}}/auth/login" },
          "response": []
        },
        { "name": "Get my profile", "request": { "method": "GET", "header": [{"key":"Authorization","value":"Bearer {{token}}"}], "url": "{{baseUrl}}/auth/me" }, "response": [] },
        { "name": "Update my profile", "request": { "method": "PUT", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}], "body": {"mode":"raw","raw":"{\n  \"fullName\": \"Đinh Gia Khiêm\"\n}"}, "url": "{{baseUrl}}/auth/profile" }, "response": [] }
      ]
    },
    {
      "name": "03. Catalog",
      "item": [
        { "name": "Get subjects", "request": {"method":"GET","header":[],"url":"{{baseUrl}}/subjects"}, "response": [] },
        { "name": "Get categories", "request": {"method":"GET","header":[],"url":"{{baseUrl}}/categories"}, "response": [] },
        { "name": "Create subject (Admin)", "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Tạo môn học thành công', () => pm.response.to.have.status(201));","pm.collectionVariables.set('subjectId', pm.response.json().item.id);"]}}], "request": {"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Môn học demo Postman {{$timestamp}}\",\n  \"description\": \"Dữ liệu kiểm thử\"\n}"},"url":"{{baseUrl}}/subjects"}, "response": [] },
        { "name": "Update subject (Admin)", "request": {"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Môn học demo đã cập nhật {{$timestamp}}\",\n  \"description\": \"Dữ liệu kiểm thử cập nhật\"\n}"},"url":"{{baseUrl}}/subjects/{{subjectId}}"}, "response": [] },
        { "name": "Delete subject (Admin)", "request": {"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/subjects/{{subjectId}}"}, "response": [] },
        { "name": "Create category (Admin)", "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Tạo danh mục thành công', () => pm.response.to.have.status(201));","pm.collectionVariables.set('categoryId', pm.response.json().item.id);"]}}], "request": {"method":"POST","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Tài liệu demo {{$timestamp}}\",\n  \"description\": \"Dữ liệu kiểm thử\"\n}"},"url":"{{baseUrl}}/categories"}, "response": [] },
        { "name": "Update category (Admin)", "request": {"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"name\": \"Danh mục demo đã cập nhật {{$timestamp}}\",\n  \"description\": \"Dữ liệu kiểm thử cập nhật\"\n}"},"url":"{{baseUrl}}/categories/{{categoryId}}"}, "response": [] },
        { "name": "Delete category (Admin)", "request": {"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/categories/{{categoryId}}"}, "response": [] }
      ]
    },
    {
      "name": "04. Learning Resources",
      "item": [
        { "name": "Search, filter and paginate", "request": {"method":"GET","header":[],"url":"{{baseUrl}}/resources?search=&sort=newest&page=1&limit=9"}, "response": [] },
        { "name": "Get resource detail", "request": {"method":"GET","header":[],"url":"{{baseUrl}}/resources/{{resourceId}}"}, "response": [] },
        { "name": "My resources (Lecturer)", "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{lecturerToken}}"}],"url":"{{baseUrl}}/resources/my-resources"}, "response": [] },
        {
          "name": "Upload resource (Lecturer)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Upload tạo trạng thái chờ duyệt', function () { pm.response.to.have.status(201); });", "pm.collectionVariables.set('pendingResourceId', pm.response.json().item.id);"] } }],
          "request": { "method":"POST", "header":[{"key":"Authorization","value":"Bearer {{lecturerToken}}"}], "body": {"mode":"formdata","formdata":[{"key":"title","value":"Tài liệu demo Postman","type":"text"},{"key":"description","value":"Học liệu minh chứng thao tác upload qua Postman.","type":"text"},{"key":"subjectId","value":"1","type":"text"},{"key":"categoryId","value":"1","type":"text"},{"key":"keywords","value":"postman, demo, khim hub","type":"text"},{"key":"accessLevel","value":"AUTHENTICATED","type":"text"},{"key":"file","type":"file","src":""}]}, "url":"{{baseUrl}}/resources" },
          "response": []
        },
        { "name": "Update resource (Lecturer)", "request": {"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{lecturerToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"title\": \"Tài liệu demo Postman - đã cập nhật\",\n  \"keywords\": \"postman, cap nhat\"\n}"},"url":"{{baseUrl}}/resources/{{resourceId}}"}, "response": [] },
        { "name": "Preview PDF", "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/resources/{{resourceId}}/preview"}, "response": [] },
        { "name": "Download resource", "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/resources/{{resourceId}}/download"}, "response": [] },
        { "name": "Delete resource (Owner/Admin)", "request": {"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{lecturerToken}}"}],"url":"{{baseUrl}}/resources/{{resourceId}}"}, "response": [] }
      ]
    },
    {
      "name": "05. Favorites and History",
      "item": [
        { "name": "Get favorites", "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{studentToken}}"}],"url":"{{baseUrl}}/favorites"}, "response": [] },
        { "name": "Add favorite", "request": {"method":"POST","header":[{"key":"Authorization","value":"Bearer {{studentToken}}"}],"url":"{{baseUrl}}/favorites/{{favoriteResourceId}}"}, "response": [] },
        { "name": "Delete favorite", "request": {"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{studentToken}}"}],"url":"{{baseUrl}}/favorites/{{favoriteResourceId}}"}, "response": [] },
        { "name": "Download history", "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{studentToken}}"}],"url":"{{baseUrl}}/history/downloads"}, "response": [] }
      ]
    },
    {
      "name": "06. Administration",
      "item": [
        { "name":"Dashboard statistics", "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/admin/statistics"},"response":[] },
        { "name":"Pending approvals", "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/admin/approvals"},"response":[] },
        { "name":"Approve resource", "request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/admin/approvals/{{pendingResourceId}}/approve"},"response":[] },
        { "name":"Reject resource", "request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"reason\": \"Thiếu mô tả hoặc thông tin học liệu chưa đầy đủ.\"\n}"},"url":"{{baseUrl}}/admin/approvals/{{pendingResourceId}}/reject"},"response":[] },
        { "name":"Get users", "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/admin/users"},"response":[] },
        { "name":"Lock or unlock user", "request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"status\": \"LOCKED\"\n}"},"url":"{{baseUrl}}/admin/users/{{userId}}/status"},"response":[] },
        { "name":"Change user role", "request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"role\": \"LECTURER\"\n}"},"url":"{{baseUrl}}/admin/users/{{userId}}/role"},"response":[] },
        { "name":"Recent activities", "request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{adminToken}}"}],"url":"{{baseUrl}}/admin/activities"},"response":[] }
      ]
    }
  ]
}
